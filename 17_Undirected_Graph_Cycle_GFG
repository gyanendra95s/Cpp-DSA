class Solution {
  public:
    bool Cycle(int src,int par,vector<int>& vis,list<int>l[]){
        vis[src]=true;

        list<int>neighbour=l[src];
        for(int v:neighbour){
            if(!vis[v]){
                if(Cycle(v,src,vis,l)){
                    return true;
                }
            }
            else{
                if(v!=par){
                    return true;
                }
            }
        }
        return false;
    }
    bool isCycle(int V, vector<vector<int>>& edges) {
        // Code here

        list<int>l[V];
        for(int i=0;i<edges.size();i++){
            int u=edges[i][0];
            int v=edges[i][1];

            l[u].push_back(v);
            l[v].push_back(u);
        }

        vector<int>vis(V,false);

        for(int i=0;i<V;i++){
            if(!vis[i]){
                if(Cycle(i,-1,vis,l)){
                    return true;
                }
            }
        }
        return false;
    }
};
