class Solution {
public:
    ListNode* oddEvenList(ListNode* head) {
        ListNode* temp=head;
        ListNode* odd=new ListNode(NULL);
        ListNode* oddd=odd;

        ListNode* even=new ListNode(NULL);
        ListNode* evenn=even;
        int count=1;
        while(temp!=NULL){
            if((count%2)!=0){
                oddd->next=temp;
                oddd=oddd->next;
            }
            else{
                evenn->next=temp;
                evenn=evenn->next;
            }
            temp=temp->next;
            count++;
        }
        evenn->next=NULL;
        oddd->next=even->next;

        return odd->next;
    }
};
