    int fibSum(int n) {
        int a=0;
            int b=1;
            int c;
            int sum=1;
            if(n==0){
                return 0;
            }
            if(n==1){
                return 1;
            }

            for(int i=2;i<=n;i++){
                c=(a+b)%1000000007;
                a=b;
                b=c;
                sum=(sum+c)%1000000007;
            }
            return sum;
    }
