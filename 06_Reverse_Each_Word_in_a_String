class Solution {
  public:
    string reverseWords(string &s) {
        // code here
        stack<char>st;
        string str="";
        for(int i=0;i<s.length();i++){
            if(s[i]!=' '){
                st.push(s[i]);
            }
            
            else{
                if(!st.empty()){
                while(!st.empty()){
                    str+=st.top();
                    st.pop();
                }
                str+=' ';
                }
            }
        }
         while(!st.empty()){
                    str+=st.top();
                    st.pop();
                }
                
        if(str.back()==' '){
            str.pop_back();
        }
        return str;
    }
};
