class Solution {
  public:
    Node* sort(Node* head) {
        // code here
        Node* temp=head;
        vector<int>ans;
        
        while(temp!=NULL){
            ans.push_back(temp->data);
            temp=temp->next;
        }
        
        std::sort(ans.begin(),ans.end());
        
        temp=head;
        int i=0;
        while(temp!=NULL){
            temp->data=ans[i++];
            temp=temp->next;
        }
        return head;
    }
};
