#include <bits/stdc++.h>
using namespace std;

class Node{
    public:
    int data;
    Node* next;

    Node(int x){
        data=x;
        next=NULL;
    }
};
Node* partition(Node* head, int x) {
        // code here
        Node* temp=head;
        Node* before_head=new Node(0);
        Node* before=before_head;
        
        Node* equal_head=new Node(0);
        Node* equal=equal_head;
        
        Node* after_head=new Node(0);
        Node* after=after_head;
        
        while(temp!=NULL){
            if(temp->data<x){
                before->next=temp;
                before=before->next;
            }
            
            else if(temp->data==x){
                equal->next=temp;
                equal=equal->next;
            }
            
            else{
                after->next=temp;
                after=after->next;
            }
            temp=temp->next;
        }
        after->next=NULL;
        before->next=equal_head->next;
        equal->next=after_head->next;
        
        return before_head->next;
    }

void printList(Node* head){
    Node* temp=head;

    while(temp!=NULL){
        cout<<temp->data<<" ";
        temp=temp->next;
    }
}
int main() {
    Node* head=new Node(1);

    head->next=new Node(4);
    head->next->next=new Node(3);
    head->next->next->next=new Node(2);
    head->next->next->next->next=new Node(3);
    head->next->next->next->next->next=new Node(5);

    int x=3;

    cout << "Original List: ";
    printList(head);

    head = partition(head, x);

    cout << "\nPartitioned List: ";
    printList(head);
    
    return 0;
}
