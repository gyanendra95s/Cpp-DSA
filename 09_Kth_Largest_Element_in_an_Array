#include <bits/stdc++.h>
using namespace std;

int kthLargest(vector<int> &arr, int k) {
        // code here
        int count=0;
        stack<int>st;
        sort(arr.begin(),arr.end());
        for(int i=0;i<arr.size();i++){
            st.push(arr[i]);
        }
        
        while(!st.empty() ){
            if(count==k-1){
                return st.top();
            }
            else{
            st.pop();
            }
            count++;
        }
        return -1;
}

int main() {
    vector<int>arr={4,3,7,6,5};
    int k=5;

    cout<<kthLargest(arr,k);
    
    return 0;
}



